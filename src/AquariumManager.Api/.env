# AquariumManager - Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DB_CONNECTION=Server=localhost,1433;Database=AquariumManager;User Id=sa;Password=12345ABC!;TrustServerCertificate=True;

# JWT Authentication
