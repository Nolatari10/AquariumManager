# AquariumManager - Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DB_CONNECTION=Host=localhost;Port=5432;Database=AquariumManager;Username=postgres;Password=postgres123

# JWT Authentication
JWT_KEY=AquariumManagerSuperSecretKeyForJwt2024!@#$%
JWT_ISSUER=AquariumManager.Api
JWT_AUDIENCE=AquariumManager.Client

# CORS
CORS_ORIGIN=http://localhost:5173
